{
  "name": "court-case-scheduling-portal",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\" \"npm run ai\"",
    "server": "nodemon --watch server server/index.js",
    "client": "npm --prefix client run dev -- --host 0.0.0.0",
    "ai": "python python/ai_recommender.py",
    "seed": "node server/seed.js",
    "start": "node server/index.js"
  },
  "dependencies": {
    "axios": "^1.6.6",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.1",
    "express": "^4.18.4",
    "express-rate-limit": "^6.11.0",
    "helmet": "^7.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^7.5.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.10.1",
    "socket.io": "^4.7.2"
  },
  "devDependencies": {
    "concurrently": "^9.0.1",
    "mongodb-memory-server": "^11.2.0",
    "nodemon": "^3.1.0"
  }
}
