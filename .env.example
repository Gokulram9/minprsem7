# ========================================================
# COURT CASE ALLOCATION & LEGAL AID PORTAL - ENV CONFIG
# ========================================================

# --- Server & Environment ---
NODE_ENV=development
PORT=5000

# --- MongoDB Atlas Connection ---
# Obtain from MongoDB Atlas -> Connect -> Connect your application
MONGODB_URI=mongodb+srv://<username>:<password>@courtcluster.hlaocvi.mongodb.net/court_case_db?retryWrites=true&w=majority
# Fallback local connection string used if MONGODB_URI is unreachable
MONGO_URI=mongodb://localhost:27017/court_case_db

# --- Authentication & JWT Security ---
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_a_secure_minimum_32_character_secret_key
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=replace_with_a_different_secure_refresh_token_secret

# --- Frontend & CORS Origins ---
# Comma-separated or single primary production origin
CLIENT_URL=http://localhost:5175

# --- AI Recommendation & NLP Engine ---
# Internal Python Flask / Scikit-learn microservice
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_URL_JUDGMENTS=http://localhost:8000

# --- Transactional Email (Nodemailer SMTP) ---
# For Gmail: Use App Password (https://myaccount.google.com/apppasswords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_court_portal_email@gmail.com
SMTP_PASS=your_16_digit_app_password
SMTP_FROM="Court Case Portal <no-reply@courtportal.gov.in>"

# --- Document Storage ---
UPLOAD_FOLDER=uploads
