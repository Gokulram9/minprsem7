# ========================================================
# FRONTEND VITE CLIENT ENVIRONMENT CONFIG
# ========================================================

# Base API URL for the deployed backend (for local dev, keep /api proxy)
# Example production values:
# VITE_API_URL=https://your-backend.vercel.app/api
# VITE_SOCKET_URL=https://your-backend.vercel.app
VITE_API_URL=/api

# WebSocket Server URL for real-time messaging & notifications
VITE_SOCKET_URL=http://localhost:5000

